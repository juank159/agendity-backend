# Plantilla de variables de entorno del backend de Agendity.
# Copiar a `.env` y rellenar. NUNCA versionar el `.env` real ni poner aquí valores reales.
# Todas las claves que lee el código (src/) y docker-compose.yaml.

# --- Entorno ---
# development | production | test. Los atajos de pago de prueba (WOMPI_MODE=stub,
# enlaces myapp://payment-demo, página /api/demo-payment) solo existen con `development`.
NODE_ENV=development

# --- Servidor HTTP (opcionales) ---
# Host de escucha. Por defecto 0.0.0.0 (todas las interfaces: móvil en la LAN, contenedores).
# Usa 127.0.0.1 para escuchar solo en esta máquina.
IP_LOCAL=0.0.0.0
# Puerto. Por defecto 3000.
PORT=3000

# --- Zona horaria del negocio ---
# Zona IANA en la que se interpretan las horas de pared: fechas sin offset que manda la app,
# días de las estadísticas, horario de los profesionales, textos de recordatorios y crons diarios.
# Las fechas de la BD son `timestamptz` (instantes) y las respuestas salen en ISO con este offset.
# Por defecto America/Bogota (UTC-5, sin horario de verano). Una zona inválida impide arrancar.
BUSINESS_TIMEZONE=America/Bogota

# --- Recordatorios de cita (2.09a) ---
# Cron por minuto que deja una notificación interna al profesional cuando su cita
# PENDING/CONFIRMED entra en la ventana de 60/30/15 min. `false` lo apaga. Con
# NODE_ENV=test nunca corre. No escribe al cliente (WhatsApp automático en pausa, D-05).
REMINDERS_CRON_ENABLED=true
# `true` = además avisa al número del propio Owner por CallMeBot (su configuración
# de /whatsapp/config). Apagado por defecto.
REMINDER_OWNER_WHATSAPP=false

# --- Base de datos PostgreSQL (también la usa docker-compose.yaml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_NAME=agendity
# El esquema solo cambia con migraciones (src/migrations/; `synchronize` está apagado).
# `true` = aplicar las migraciones pendientes al arrancar (despliegue). Por defecto false:
# en desarrollo se aplican a mano con `npm run migration:run`.
DB_MIGRATIONS_RUN=false

# --- pgAdmin (solo docker-compose.yaml) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# --- Autenticación ---
# Secreto para firmar los JWT. Cadena larga y aleatoria (p. ej. `openssl rand -hex 32`).
SECRET_KEY_JWT=change_me
# Client IDs de OAuth de Google aceptados como audiencia del ID token (login con Google).
# Lista separada por comas, uno por plataforma de la app: web, iOS y Android (se ignoran espacios).
# Vacía o ausente = el login con Google responde 401 UNAUTHORIZED (nunca se acepta un token sin audiencia).
GOOGLE_CLIENT_ID=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com

# --- Email (nodemailer con Gmail: códigos de verificación y de recuperación) ---
EMAIL_USER=your-account@gmail.com
# Contraseña de aplicación de Gmail, no la contraseña de la cuenta.
EMAIL_PASSWORD=change_me

# --- Cloudinary (subida de imágenes) ---
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# --- Firebase (push; hoy ningún módulo lo usa) ---
FIREBASE_PROJECT_ID=change_me
FIREBASE_CLIENT_EMAIL=service-account@change_me.iam.gserviceaccount.com
# Con saltos de línea escapados: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="change_me"

# --- Wompi (pagos de suscripción) ---
# Con NODE_ENV=production la app NO arranca si falta alguna de estas tres.
WOMPI_PUBLIC_KEY=pub_test_change_me
WOMPI_PRIVATE_KEY=prv_test_change_me
WOMPI_EVENT_INTEGRITY_SECRET=test_integrity_change_me
# `stub` = respuestas simuladas (solo con NODE_ENV=development). Cualquier otro valor = real.
WOMPI_MODE=normal
# URL https a la que Wompi redirige tras pagar (obligatoria en producción).
WOMPI_REDIRECT_URL=https://example.com/payment-callback

# --- Monitoreo (opcional, solo producción) ---
# Webhook al que se avisa de errores de la integración de pagos.
MONITORING_WEBHOOK=
